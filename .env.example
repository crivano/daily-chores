# ---------------------------------------------------------------------------
# Daily Chores — variáveis de ambiente
# Copie para .env (dev) ou configure no Secret Manager (produção).
# ---------------------------------------------------------------------------

# --- Auth.js v5 (obrigatório) ----------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# URL pública da app (dev: http://localhost:3000)
AUTH_URL=http://localhost:3000
# Credenciais OAuth do Google Console (origens autorizadas: localhost:3000 + URL do Cloud Run)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ---------------------------------------------------------------------
# URL pública usada para montar os targets do Cloud Tasks e o audience do OIDC
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Banco (Neon Postgres) ----------------------------------------------------
# DATABASE_URL = string POOLED (host com sufixo -pooler) — runtime
# DIRECT_URL   = conexão direta — migrations (prisma migrate deploy)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Web Push (VAPID) ---------------------------------------------------------
# Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# (opcional) contato para os servidores de push
VAPID_CONTACT_EMAIL=

# --- Cloud Tasks (produção) ----------------------------------------------------
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# SA que assina os OIDC tokens dos tasks (precisa de roles/run.invoker)
ALARM_SA_EMAIL=alarm-runner@SEU_PROJETO.iam.gserviceaccount.com
# Audience do OIDC — normalmente igual a NEXT_PUBLIC_APP_URL
CLOUD_TASKS_AUDIENCE=http://localhost:3000

# --- Apenas desenvolvimento ----------------------------------------------------
# Token aceito pelos endpoints /api/internal/* quando não há OIDC (fila local de alarmes)
DEV_ALARM_TOKEN=dev-alarm-token-troque
# Credenciais da SA para ADC fora do Cloud Run (opcional)
GOOGLE_APPLICATION_CREDENTIALS=
